# ==============================================================================
# 1. KREDENSIAL AKUN SIPRAKERIN (WAJIB)
# ==============================================================================
# Cukup isi email dan password akun Siprakerin kamu.
# ID_KELAS dan ID_INDUSTRI akan dideteksi 100% otomatis oleh bot.
USER_EMAIL=nis_kamu@siprakerin.com
USER_PASSWORD=password_akun_kamu

# ==============================================================================
# 2. PENGATURAN TARGET JAM ABSEN (WIB)
# ==============================================================================
# Jam berapa kamu ingin absen otomatis dieksekusi (Format 24 jam WIB: HH:mm).
# Contoh: 07:15, 07:30, 08:00
JAM_ABSEN_WIB=07:15

# ==============================================================================
# 3. PENGATURAN HARI LIBUR & AKHIR PEKAN (WAJIB DITENTUKAN SENDIRI)
# ==============================================================================
# HARI_LIBUR = Hari libur rutin mingguan (berulang setiap minggu).
# Pilihan hari: senin, selasa, rabu, kamis, jumat, sabtu, minggu (pisahkan koma).
# Contoh 5 hari kerja (Sabtu & Minggu libur) : HARI_LIBUR=sabtu,minggu
# Contoh 6 hari kerja (Hanya Minggu libur)   : HARI_LIBUR=minggu
# PERINGATAN: Jangan biarkan kosong! Bot akan menampilkan warning jika belum disetel.
HARI_LIBUR=sabtu,minggu

# TANGGAL_LIBUR = Libur di tanggal masa depan tertentu (berlaku hanya di tanggal itu).
# Format: YYYY-MM-DD dipisah koma (contoh: libur semester, cuti kantor, class meeting).
# Contoh: TANGGAL_LIBUR=2026-10-28,2026-12-25
# Catatan: Tanggal merah nasional resmi dari sistem SIPRAKERIN akan dicek otomatis.
TANGGAL_LIBUR=

# ==============================================================================
# 4. PENGATURAN KEGIATAN ABSENSI
# ==============================================================================
# Tentukan deskripsi kegiatan apa yang ditulis bot saat mengisi jurnal harian.
# 
# ATURAN PRIORITAS:
# 1. KEGIATAN_<HARI>      -> Prioritas TERTINGGI (dipakai untuk hari itu saja).
# 2. KEGIATAN_SETIAP_HARI -> Dipakai untuk hari-hari lain yang tidak punya kegiatan khusus.
# 3. Default ('hadir')    -> Jika SEMUA baris di bawah dikosongkan, bot otomatis mengisi 'hadir'.
#
# TIPS FITUR ACAK (RANDOMIZER):
# Kamu bisa memasukkan lebih dari satu variasi kalimat dengan memisahkannya menggunakan
# tanda pipa '|'. Bot akan otomatis memilih salah satu secara acak setiap minggunya
# agar isi jurnalmu tidak terlihat monoton/seperti robot!
#
# CONTOH CARA MENGISI:
#
# Contoh 1: Paling simpel (cuma 1 kalimat sama tiap hari)
# KEGIATAN_SETIAP_HARI=Melaksanakan tugas harian dan instruksi pembimbing industri
#
# Contoh 2: Variasi acak tiap hari (dipisah tanda pipa '|')
# KEGIATAN_SETIAP_HARI=Mengerjakan tugas proyek PKL|Membantu operasional tim|Menyusun dokumentasi harian
#
# Contoh 3: Hari Senin & Jumat beda sendiri, hari lain sama
# KEGIATAN_SENIN=Mengikuti briefing mingguan dan evaluasi target
# KEGIATAN_JUMAT=Membersihkan workstation dan rekap laporan pekanan
# KEGIATAN_SETIAP_HARI=Melanjutkan pengerjaan tugas proyek industri
# (Hasilnya: Senin pakai briefing, Jumat pakai rekap, Selasa-Kamis pakai tugas proyek).

# --- [OPSI A] KEGIATAN KHUSUS PER HARI (Kosongkan jika tidak ada kegiatan khusus) ---
KEGIATAN_SENIN=
KEGIATAN_SELASA=
KEGIATAN_RABU=
KEGIATAN_KAMIS=
KEGIATAN_JUMAT=
KEGIATAN_SABTU=
KEGIATAN_MINGGU=

# --- [OPSI B] KEGIATAN UMUM SETIAP HARI (Kosongkan jika ingin default hanya kata 'hadir') ---
KEGIATAN_SETIAP_HARI=